<?xml version="1.0" encoding="utf-8"?>
<SvgDef xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" CreateCommonAvary="false">
  <ParameterDefs>
    <ParameterDef Name="TileName" DisplayName="Название кнопки" Type="STRING" ParamType="Attribute" ItemId="name_text" Path="Content" />
    <ParameterDef Name="ButtonState" DisplayName="Состояние кнопки" Type="STRING" ParamType="Attribute" ItemId="nav_btn" Path="class">
      <Value DisplayName="Дежурное">Idle</Value>
      <Value DisplayName="Наведение">Hover</Value>
      <Value DisplayName="Выбрана">Active</Value>
    </ParameterDef>
    <ParameterDef Name="IconColorIdle" DisplayName="Цвет иконки/текста (дежурный)" Type="STRING" ParamType="Attribute" ItemId="content_idle" Path="color" />
    <ParameterDef Name="IconColorHover" DisplayName="Цвет иконки/текста (наведение)" Type="STRING" ParamType="Attribute" ItemId="content_hover" Path="color" />
    <ParameterDef Name="IconColorActive" DisplayName="Цвет иконки/текста (выбрана)" Type="STRING" ParamType="Attribute" ItemId="content_active" Path="color" />
    <ParameterDef Name="ButtonColorIdle" DisplayName="Цвет кнопки (дежурный)" Type="HMI.SolidColorType" ParamType="Attribute" ItemId="btn_bg_idle" Path="fill" />
    <ParameterDef Name="ButtonColorActive" DisplayName="Цвет кнопки (выбрана)" Type="HMI.SolidColorType" ParamType="Attribute" ItemId="btn_bg_active" Path="fill" />
    <ParameterDef Name="BadgeVisible" DisplayName="Видимость круга" Type="STRING" ParamType="Attribute" ItemId="badge" Path="class">
      <Value DisplayName="Показать">On</Value>
      <Value DisplayName="Скрыть">Off</Value>
    </ParameterDef>
    <ParameterDef Name="BadgeColor" DisplayName="Цвет круга" Type="HMI.SolidColorType" ParamType="Attribute" ItemId="badge_circle" Path="fill" />
    <ParameterDef Name="BadgeText" DisplayName="Текст в круге" Type="STRING" ParamType="Attribute" ItemId="badge_text" Path="Content" />
  </ParameterDefs>
</SvgDef>