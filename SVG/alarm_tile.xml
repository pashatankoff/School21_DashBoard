    <ParameterDef Name="LabelColor" DisplayName="Цвет подписей слева" Type="HMI.SolidColorType" ParamType="Attribute" ItemId="label_group" Path="fill" />
    <ParameterDef Name="UnitColor" DisplayName="Цвет единиц" Type="HMI.SolidColorType" ParamType="Attribute" ItemId="unit_group" Path="fill" />
