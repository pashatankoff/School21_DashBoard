<?xml version="1.0" encoding="utf-8"?>
<SvgDef xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" CreateCommonAvary="false">
  <ParameterDefs>
    <ParameterDef Name="TileName" DisplayName="Название плитки" Type="STRING" ParamType="Attribute" ItemId="name_text" Path="Content" />
    <ParameterDef Name="TileTitleColor" DisplayName="Цвет заголовка" Type="HMI.SolidColorType" ParamType="Attribute" ItemId="name_text" Path="fill" />
