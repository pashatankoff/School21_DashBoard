      <Value DisplayName="80">spd-80</Value>
      <Value DisplayName="70">spd-70</Value>
      <Value DisplayName="60">spd-60</Value>
      <Value DisplayName="50">spd-50</Value>
      <Value DisplayName="40">spd-40</Value>
