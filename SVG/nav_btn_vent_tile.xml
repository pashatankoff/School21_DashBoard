<?xml version="1.0" encoding="utf-8"?>
<SvgDef xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" CreateCommonAvary="false">
  <ParameterDefs>
    <ParameterDef Name="TileName" DisplayName="Название кнопки" Type="STRING" ParamType="Attribute" ItemId="name_text" Path="Content" />
    <ParameterDef Name="ButtonState" DisplayName="Состояние кнопки" Type="STRING" ParamType="Attribute" ItemId="nav_button" Path="class">
      <Value DisplayName="Дежурный">Normal</Value>
      <Value DisplayName="При наведении">Hover</Value>
      <Value DisplayName="При выборе">Active</Value>
    </ParameterDef>
    <ParameterDef Name="TileBackgroundColor" DisplayName="Цвет фона (свой)" Type="HMI.SolidColorType" ParamType="Attribute" ItemId="tile_bg" Path="fill" />
    <ParameterDef Name="IconCircleColor" DisplayName="Цвет кольца иконки (свой)" Type="HMI.SolidColorType" ParamType="Attribute" ItemId="icon_circle" Path="stroke" />
    <ParameterDef Name="IconPathColor" DisplayName="Цвет лопастей иконки (свой)" Type="HMI.SolidColorType" ParamType="Attribute" ItemId="icon_path" Path="stroke" />
    <ParameterDef Name="TileNameColor" DisplayName="Цвет текста кнопки (свой)" Type="HMI.SolidColorType" ParamType="Attribute" ItemId="name_text" Path="fill" />
    <ParameterDef Name="BadgeVisible" DisplayName="Видимость кружка" Type="STRING" ParamType="Attribute" ItemId="badge_group" Path="class">
      <Value DisplayName="Показать">On</Value>
      <Value DisplayName="Скрыть">Off</Value>
    </ParameterDef>
    <ParameterDef Name="BadgeColor" DisplayName="Цвет кружка" Type="HMI.SolidColorType" ParamType="Attribute" ItemId="badge_bg" Path="fill" />
    <ParameterDef Name="BadgeText" DisplayName="Текст кружка" Type="STRING" ParamType="Attribute" ItemId="badge_text" Path="Content" />
    <ParameterDef Name="BadgeTextColor" DisplayName="Цвет текста кружка" Type="HMI.SolidColorType" ParamType="Attribute" ItemId="badge_text" Path="fill" />
  </ParameterDefs>
</SvgDef>