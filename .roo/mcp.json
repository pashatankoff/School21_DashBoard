{
	"mcpServers": {
		"filesystem": {
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-filesystem",
				"."
			],
			"alwaysAllow": [
				"read_file",
				"write_file",
				"read_text_file"
			]
		},
		"playwright": {
			"command": "npx",
			"args": [
				"-y",
				"@playwright/mcp@latest"
			]
		},
		"git": {
			"command": "npx",
			"args": [
				"-y",
				"mcp-git"
			]
		}
	}
}